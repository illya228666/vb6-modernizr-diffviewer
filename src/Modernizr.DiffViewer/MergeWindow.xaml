<Window x:Class="Modernizr.DiffViewer.MergeWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Synchronize with disk" Width="1120" Height="590" MinWidth="630" MinHeight="400"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="FileLabel" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="Status" Margin="0,6,0,0"/>
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="Previous" Content="Previous conflict" Padding="10,5" Click="Previous_Click"/>
                <Button x:Name="Next" Content="Next conflict" Padding="10,5" Margin="6,0,0,0" Click="Next_Click"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Padding="16,5"/>
            <Button x:Name="Apply" DockPanel.Dock="Right" Content="Apply in VB6" IsDefault="True"
                    Margin="0,0,8,0" Padding="16,5" Click="Apply_Click"/>
        </DockPanel>
        <Grid>
          <Grid x:Name="Versions">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid.Resources>
                <Style TargetType="TextBox">
                    <Setter Property="IsReadOnly" Value="True"/>
                    <Setter Property="FontFamily" Value="Consolas"/>
                    <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
                    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                    <Setter Property="Padding" Value="6"/>
                    <Setter Property="Margin" Value="0,6,0,0"/>
                </Style>
            </Grid.Resources>
            <DockPanel Margin="0,0,6,0">
                <TextBlock DockPanel.Dock="Top" Text="Original"/>
                <TextBox x:Name="Original" AutomationProperties.Name="Original code"/>
            </DockPanel>
            <DockPanel Grid.Column="1" Margin="6,0">
                <RadioButton x:Name="EditorChoice" GroupName="Choice" DockPanel.Dock="Top"
                             Content="Use code from VB6" Checked="Version_Checked"/>
                <TextBox x:Name="Editor" AutomationProperties.Name="Unsaved VB6 code"/>
            </DockPanel>
            <DockPanel Grid.Column="2" Margin="6,0,0,0">
                <RadioButton x:Name="DiskChoice" GroupName="Choice" DockPanel.Dock="Top"
                             Content="Use code from disk" Checked="Version_Checked"/>
                <TextBox x:Name="Disk" AutomationProperties.Name="Code from disk"/>
            </DockPanel>
          </Grid>
          <TextBox x:Name="Combined" Visibility="Collapsed" IsReadOnly="True" FontFamily="Consolas"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Merged code preview"/>
        </Grid>
    </DockPanel>
</Window>
