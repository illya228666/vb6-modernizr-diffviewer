<Window x:Class="Modernizr.DiffViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Modernizr.DiffViewer"
        Title="Modernizr DiffViewer" Width="1100" Height="720" MinWidth="700" MinHeight="380"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}"
        UseLayoutRounding="True" PreviewKeyDown="Window_KeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="11,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Rule}"
                                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Number" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Padding" Value="4,0,8,0" />
        </Style>
        <Style x:Key="LeftTone" TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Left.Type}" Value="Deleted">
                    <Setter Property="Background" Value="{DynamicResource RemovedLine}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Left.Type}" Value="Modified">
                    <Setter Property="Background" Value="{DynamicResource RemovedLine}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Left.Type}" Value="Imaginary">
                    <Setter Property="Background" Value="{DynamicResource Blank}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RightTone" TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Right.Type}" Value="Inserted">
                    <Setter Property="Background" Value="{DynamicResource AddedLine}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Right.Type}" Value="Modified">
                    <Setter Property="Background" Value="{DynamicResource AddedLine}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Right.Type}" Value="Imaginary">
                    <Setter Property="Background" Value="{DynamicResource Blank}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="InlineTone" TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Marker}" Value="−">
                    <Setter Property="Background" Value="{DynamicResource RemovedLine}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Marker}" Value="+">
                    <Setter Property="Background" Value="{DynamicResource AddedLine}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Code" TargetType="local:DiffCell">
            <Setter Property="Canvas.Left" Value="{Binding HorizontalOffset, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Padding" Value="7,0,0,0" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
        </Style>
        <DataTemplate x:Key="SideRow">
            <Grid Height="21">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid Style="{StaticResource LeftTone}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55" />
                        <ColumnDefinition Width="15" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Number}" Text="{Binding Left.Position}" />
                    <TextBlock Grid.Column="1" Foreground="{DynamicResource Muted}" Text="{Binding LeftMarker}" />
                    <Canvas Grid.Column="2" ClipToBounds="True">
                        <local:DiffCell Style="{StaticResource Code}" Piece="{Binding Left}" />
                    </Canvas>
                </Grid>
                <Border Grid.Column="1" Background="{DynamicResource Rule}" />
                <Grid Grid.Column="2" Style="{StaticResource RightTone}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55" />
                        <ColumnDefinition Width="15" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Number}" Text="{Binding Right.Position}" />
                    <TextBlock Grid.Column="1" Foreground="{DynamicResource Muted}" Text="{Binding RightMarker}" />
                    <Canvas Grid.Column="2" ClipToBounds="True">
                        <local:DiffCell Style="{StaticResource Code}" Piece="{Binding Right}" />
                    </Canvas>
                </Grid>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="InlineRow">
            <Grid Height="21" Style="{StaticResource InlineTone}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="55" />
                    <ColumnDefinition Width="55" />
                    <ColumnDefinition Width="15" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Number}" Text="{Binding Left.Position}" />
                <TextBlock Grid.Column="1" Style="{StaticResource Number}" Text="{Binding Right.Position}" />
                <TextBlock Grid.Column="2" Foreground="{DynamicResource Muted}" Text="{Binding Marker}" />
                <Canvas Grid.Column="3" ClipToBounds="True">
                    <local:DiffCell Style="{StaticResource Code}" Piece="{Binding InlinePiece}" />
                </Canvas>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ContextRow">
            <Border Height="23" Background="{DynamicResource Panel}" Padding="12,1">
                <TextBlock Foreground="{DynamicResource Muted}" Text="{Binding ContextLabel}" />
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="18,14,18,12">
            <TextBlock x:Name="FileTitle" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <TextBlock x:Name="Repository" Foreground="{DynamicResource Muted}" Margin="0,3,0,0"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="18,0,12,10">
            <Button DockPanel.Dock="Right" x:Name="ThemeButton" Click="Theme_Click" />
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ModeButton" Content="Inline view" Click="Mode_Click" IsEnabled="False" />
                <Button x:Name="ContextButton" Content="Hide unchanged" Click="Context_Click" IsEnabled="False" />
                <Button x:Name="PreviousButton" Content="Previous" ToolTip="Previous change (Shift+F7)"
                        Click="Previous_Click" IsEnabled="False" />
                <Button x:Name="NextButton" Content="Next" ToolTip="Next change (F7)"
                        Click="Next_Click" IsEnabled="False" />
                <TextBlock x:Name="ChangeCount" Margin="7,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Muted}" />
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Rule}"
                BorderThickness="0,1" Padding="12,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="OldLabel" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <TextBlock x:Name="NewLabel" Grid.Column="1" FontWeight="SemiBold" Margin="4,0,0,0"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Grid>
        </Border>
        <ListBox Grid.Row="3" x:Name="Rows" BorderThickness="0" Background="Transparent"
                 Foreground="{DynamicResource Ink}" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                 HorizontalContentAlignment="Stretch" ScrollViewer.CanContentScroll="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 SizeChanged="Rows_SizeChanged" AutomationProperties.Name="Diff lines">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="FocusRow" BorderThickness="2,0,0,0" BorderBrush="Transparent">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="FocusRow" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
        <TextBlock Grid.Row="3" x:Name="Notice" Text="Reading Git versions…" TextWrapping="Wrap"
                   MaxWidth="620" Margin="26" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"
                   Foreground="{DynamicResource Muted}" />
        <ScrollBar Grid.Row="4" x:Name="Horizontal" Orientation="Horizontal" SmallChange="26" LargeChange="240"
                   ValueChanged="Horizontal_ValueChanged" Visibility="Collapsed" AutomationProperties.Name="Horizontal code scroll" />
        <Border Grid.Row="5" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Rule}"
                BorderThickness="0,1,0,0" Padding="14,7">
            <TextBlock x:Name="Status" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Border>
    </Grid>
</Window>
